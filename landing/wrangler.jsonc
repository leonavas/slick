// Copy to wrangler.local.jsonc and set your account identifier.
// Deploy with: wrangler deploy --config wrangler.local.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slick-landing",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public" },
  "routes": [{ "pattern": "slick.leonavas.com", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
